{
  "name": "openpome",
  "version": "0.46.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "pome": "pnpm --filter @openpome/cli start",
    "validate": "pnpm typecheck && pnpm test",
    "release:publish-alpha": "node scripts/publish-alpha.mjs",
    "release:status": "node scripts/release-status.mjs",
    "smoke:jira": "node scripts/jira-api-token-smoke.mjs",
    "smoke:jira-oauth": "node scripts/jira-oauth-smoke.mjs",
    "smoke:github-oauth": "node scripts/github-oauth-smoke.mjs",
    "smoke:external": "node scripts/external-completion-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
